                            <TableColumnItem>
                                <PropertyName>Status</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Setting</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>InterfaceAlias</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>RequestedValue</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>PersistentValue</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
