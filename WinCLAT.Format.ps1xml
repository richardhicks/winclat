<?xml version="1.0" encoding="utf-8"?>
<!--
    Default table views for the WinCLAT output types (docs/DESIGN.md, section 6).
    Each view shows the identifying and deciding columns only. Every property remains on the object:
    use Format-List *, Select-Object, or Export-Csv to see the rest (for example Message, OSBuild, CollectedAtUtc).
    The last column has no width, so it takes the remaining console width. The TestResult view wraps Detail.
    The #Single list views show every property in object order, except RemotePrefixRemainingLifetimeRaw on
    WinClat.Instance, which is empty unless a lifetime could not be parsed.
-->
<Configuration>
    <ViewDefinitions>

        <View>
            <Name>WinClat.Configuration</Name>
            <ViewSelectedBy>
                <TypeName>WinClat.Configuration</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>ComputerName</Label>
                        <Width>30</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Status</Label>
                        <Width>19</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Store</Label>
                        <Width>10</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Permit</Label>
                        <Width>6</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Pref64FromDns</Label>
                        <Width>13</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Pref64FromRA</Label>
                        <Width>12</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>AutoEnable</Label>
                        <Width>10</Width>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>ComputerName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Status</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Store</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Permit</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Pref64FromDns</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Pref64FromRA</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>AutoEnable</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>

        <View>
            <Name>WinClat.Instance</Name>
            <ViewSelectedBy>
                <TypeName>WinClat.Instance</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>ComputerName</Label>
                        <Width>30</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Status</Label>
                        <Width>19</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>InterfaceAlias</Label>
                        <Width>16</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Enabled</Label>
                        <Width>7</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Translating</Label>
                        <Width>11</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Mode</Label>
                        <Width>9</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>RemotePrefix</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>ComputerName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Status</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>InterfaceAlias</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Enabled</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>IsTranslating</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Mode</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>RemotePrefix</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>

